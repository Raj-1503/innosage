---
interface Props {
	quote: string;
	name?: string;
	role?: string;
}

const { quote, name, role } = Astro.props;
---

<figure class="flex flex-col justify-between gap-8 rounded-card bg-mist p-8">
	<blockquote>
		<h6>{quote}</h6>
	</blockquote>
	<figcaption>
		<p class="text-navy">{name}</p>
		<span class="text-small">■ {role}</span>
	</figcaption>
</figure>
