---
interface Props {
	quote: string;
	name?: string;
	role?: string;
}

const { quote, name, role } = Astro.props;
---

<figure>
	<blockquote>
		<h6>{quote}</h6>
	</blockquote>
	<figcaption>
		<p>{name}</p>
		<span>■ {role}</span>
	</figcaption>
</figure>

<style>
	figure {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 32px;
		margin: 0;
		padding: 32px;
		border-radius: var(--radius);
		background: var(--mist);
	}

	blockquote {
		margin: 0;
	}

	p {
		color: var(--navy);
	}

	span {
		font-size: 14px;
	}
</style>
