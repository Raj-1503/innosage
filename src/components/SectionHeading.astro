---
import PillLink from './PillLink.astro';

interface Props {
	title: string;
	lede?: string;
	action?: { href: string; label: string };
	level?: 'h2' | 'h4';
}

const { title, lede, action, level: Heading = 'h2' } = Astro.props;
---

<div class="heading">
	<div class="copy">
		<Heading>{title}</Heading>
		{lede && <p>{lede}</p>}
	</div>
	{action && <PillLink {...action} />}
</div>

<style>
	.heading {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 32px;
		margin-bottom: 64px;
	}

	.copy {
		max-width: 960px;
	}

	p {
		margin-top: 24px;
	}
</style>
