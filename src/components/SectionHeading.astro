---
import PillLink from './PillLink.astro';

interface Props {
	title: string;
	lede?: string;
	action?: { href: string; label: string };
	level?: 'h2' | 'h4';
}

const { title, lede, action, level: Heading = 'h2' } = Astro.props;
---

<div class="mb-16 flex flex-wrap items-end justify-between gap-8">
	<div class="max-w-240">
		<Heading>{title}</Heading>
		{lede && <p class="mt-6">{lede}</p>}
	</div>
	{action && <PillLink {...action} />}
</div>
