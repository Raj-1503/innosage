---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	lede: string;
	projects: CollectionEntry<'projects'>[];
}

const { lede, projects } = Astro.props;
const rows = projects.flatMap((_, index) => (index % 2 === 0 ? [projects.slice(index, index + 2)] : []));
---

<section class="relative overflow-x-clip bg-white pb-(--section-y)">
	<div class="sticky top-0 grid h-svh place-content-center gap-8 px-(--gutter) text-center">
		<h1 class="mx-auto max-w-250 text-balance">Crafting cohesion from complexity</h1>
		<p class="mx-auto max-w-272">{lede}</p>
	</div>

	<div class="shell relative z-1 mt-[45svh] grid gap-6">
		{rows.map((row) => (
			<div class="grid gap-6 tablet:grid-cols-2">
				{row.map((project, index) => (
					<a
						class="group block desk:cursor-none"
						href={`/works/${project.id}/`}
						data-cursor="arrow"
						data-slide-in={index === 0 ? 'left' : 'right'}
					>
						<div class="overflow-hidden rounded-card bg-[#f5f4f3]">
							{project.data.coverImage && (
								<Image
									class="aspect-square object-cover transition-[scale] duration-700 ease-fill group-hover:scale-[1.04] tablet:aspect-612/600"
									src={project.data.coverImage}
									alt={project.data.title}
									widths={[600, 900, 1224]}
									sizes="(min-width: 810px) 50vw, 100vw"
									loading="lazy"
								/>
							)}
						</div>
					</a>
				))}
			</div>
		))}
	</div>
</section>
