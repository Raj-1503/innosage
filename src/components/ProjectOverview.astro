---
interface Props {
	overview?: string;
	comingSoon: boolean;
	client?: string;
	services: string[];
}

const { overview, comingSoon, client, services } = Astro.props;
const row = 'grid gap-2 border-t-3 border-mist py-12 tablet:grid-cols-[1fr_2fr]';
const term = 'text-lead font-normal tracking-[-1px]';
const value = 'font-heading text-h6 font-normal text-ink';
---

<div class="grid gap-6 tablet:grid-cols-[189px_1fr]">
	<svg class="h-28.5 w-6.75" viewBox="0 0 27 114" aria-hidden="true">
		<path class="fill-none stroke-crimson stroke-3" d="M24.643 0.301 L1.469 113.301" stroke-miterlimit="10"></path>
	</svg>
	<div>
		<h4>{comingSoon ? 'Coming Soon...' : overview}</h4>
		<dl class="mt-12 border-b-3 border-mist">
			<div class={row}>
				<dt class={term}>Client</dt>
				<dd class={value}>{client}</dd>
			</div>
			<div class={row}>
				<dt class={term}>Services</dt>
				<dd class={value}>{services.join(', ')}</dd>
			</div>
		</dl>
	</div>
</div>
