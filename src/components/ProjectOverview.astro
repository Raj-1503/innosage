---
interface Props {
	overview?: string;
	comingSoon: boolean;
	client?: string;
	services: string[];
}

const { overview, comingSoon, client, services } = Astro.props;
---

<div class="overview">
	<h4>{comingSoon ? 'Coming Soon...' : overview}</h4>
	<dl>
		<div>
			<dt>Client</dt>
			<dd>{client}</dd>
		</div>
		<div>
			<dt>Services</dt>
			<dd>{services.join(', ')}</dd>
		</div>
	</dl>
</div>

<style>
	.overview {
		display: grid;
		gap: 2.5rem;
		border-left: 3px solid var(--red);
		padding-left: clamp(1rem, 3vw, 2.5rem);
	}

	dl {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem 5rem;
		margin: 0;
	}

	dd {
		margin: 0.25rem 0 0;
		color: var(--ink);
		font-family: var(--heading-font);
		font-size: 1.25rem;
	}
</style>
