---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Video from './Video.astro';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { title, tagline, heroIntro, client, year, heroImage, heroVideo, heroColor, heroTextDark } =
	Astro.props.project.data;
const ink = heroTextDark ? 'var(--color-ink)' : '#fff';
const media = 'aspect-1248/712 rounded-card object-cover';
---

<section
	class="relative py-(--section-y)"
	style={`background:${heroColor ?? 'var(--color-navy)'};color:${ink};--heading:${ink}`}
>
	<div class="shell flex flex-wrap items-end justify-between gap-8">
		<div class="max-w-265 flex-[1_1_500px]">
			<h1>{tagline ?? title}</h1>
			{heroIntro && <h4 class="mt-6">{heroIntro}</h4>}
		</div>
		<div class="flex gap-6">
			<p>{client}</p>
			<p>({year})</p>
		</div>
	</div>
</section>

<div class="relative bg-white pt-(--section-y)">
	<div class="shell">
		{heroVideo ? (
			<Video class={media} src={heroVideo} />
		) : (
			heroImage && (
				<Image
					class={media}
					src={heroImage}
					alt={title}
					widths={[800, 1248, 2000]}
					sizes="(min-width: 1440px) 1248px, 100vw"
				/>
			)
		)}
	</div>
</div>
