---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Video from './Video.astro';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { title, tagline, heroIntro, client, year, heroImage, heroVideo, heroColor, heroTextDark } = Astro.props.project.data;
const ink = heroTextDark ? 'var(--ink)' : '#fff';
---

<section class="band" style={`background:${heroColor ?? 'var(--navy)'};color:${ink};--heading:${ink}`}>
	<div class="container copy">
		<div>
			<h1>{tagline ?? title}</h1>
			{heroIntro && <h4>{heroIntro}</h4>}
		</div>
		<div class="meta">
			<p>{client}</p>
			<p>({year})</p>
		</div>
	</div>
</section>

<div class="cover white">
	<div class="container">
		{heroVideo ? <Video src={heroVideo} /> : heroImage && <Image src={heroImage} alt={title} width={2000} />}
	</div>
</div>

<style>
	.band {
		position: relative;
		padding-block: var(--section-y);
	}

	.copy {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 32px;
	}

	.copy > div:first-child {
		flex: 1 1 500px;
		max-width: 1060px;
	}

	h4 {
		margin-top: 24px;
	}

	.meta {
		display: flex;
		gap: 24px;
	}

	.cover {
		position: relative;
		padding-top: var(--section-y);
	}

	.cover :global(:is(img, video)) {
		aspect-ratio: 1248 / 712;
		object-fit: cover;
		border-radius: var(--radius);
	}
</style>
