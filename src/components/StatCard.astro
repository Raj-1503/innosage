---
interface Props {
	value: string;
	label: string;
}

const { value, label } = Astro.props;
---

<div data-reveal>
	<h2>{value}</h2>
	<p>{label}</p>
</div>

<style>
	div {
		display: grid;
		gap: 8px;
		padding: 40px;
		border-radius: var(--radius);
		background: var(--mist);
		text-align: center;
	}
</style>
