---
interface Props {
	title: string;
	lede?: string;
	align?: 'start' | 'center';
	tone?: 'white' | 'navy';
	rule?: boolean;
	tight?: boolean;
}

const { title, lede, align = 'start', tone = 'white', rule = false, tight = false } = Astro.props;
---

<section class:list={[tone, align, { rule, tight }]}>
	<div class="container">
		<h1>{title}</h1>
		{lede && <p>{lede}</p>}
		<slot />
	</div>
</section>

<style>
	section {
		position: relative;
		padding-block: var(--section-y);
	}

	.center {
		text-align: center;
	}

	.rule {
		border-bottom: 1px solid var(--ice);
	}

	p {
		max-width: 800px;
		margin-top: 24px;
	}

	.center p {
		max-width: 1088px;
		margin-inline: auto;
	}

	.tight {
		padding-bottom: 40px;
	}
</style>
