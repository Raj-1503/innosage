---
interface Props {
	name: string;
	role: string;
}

const { name, role } = Astro.props;
---

<div class="grid grid-cols-[1fr_auto] items-center gap-x-8 gap-y-1 border-b border-ice py-8 text-ink tablet:grid-cols-[1fr_1fr_auto]">
	<h6 class="pb-0">{name}</h6>
	<p class="row-start-2 text-body tablet:row-auto">{role}</p>
	<svg
		class="col-start-2 row-span-2 row-start-1 size-5.5 tablet:col-auto tablet:row-auto"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.5"
		aria-hidden="true"
	>
		<path d="M6 18 18 6M8 6h10v10"></path>
	</svg>
</div>
