---
interface Props {
	name: string;
	role: string;
}

const { name, role } = Astro.props;
---

<div class="row">
	<h6>{name}</h6>
	<p>{role}</p>
	<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
		<path d="M6 18 18 6M8 6h10v10"></path>
	</svg>
</div>

<style>
	.row {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 4px 32px;
		align-items: center;
		padding-block: 32px;
		border-bottom: 1px solid var(--ice);
		color: var(--ink);
	}

	h6 {
		padding: 0;
	}

	p {
		grid-row: 2;
		color: var(--body);
	}

	svg {
		grid-row: 1 / span 2;
		grid-column: 2;
	}

	@media (min-width: 810px) {
		.row {
			grid-template-columns: 1fr 1fr auto;
		}

		p {
			grid-row: auto;
		}

		svg {
			grid-row: auto;
			grid-column: auto;
		}
	}
</style>
