---
interface Props {
	label: string;
	variant?: 'service' | 'card';
}

const { label, variant = 'service' } = Astro.props;
---

<span class={variant}>{label}</span>

<style>
	span {
		white-space: nowrap;
	}

	.service {
		padding: 8px 16px;
		border-radius: 100px;
		background: var(--mist);
		color: var(--navy);
		font-size: 14px;
		line-height: 24px;
	}

	.card {
		padding: 9px 20px;
		border-radius: 44px;
		background: var(--paper);
		font-size: 18px;
		font-weight: 400;
		line-height: 29px;
		letter-spacing: -1px;
	}
</style>
