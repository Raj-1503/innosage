---
interface Props {
	label: string;
	variant?: 'service' | 'card';
}

const { label, variant = 'service' } = Astro.props;
const variants = {
	service: 'rounded-full bg-mist px-4 py-2 text-small/6 text-navy',
	card: 'rounded-[44px] bg-paper px-5 py-2.25 text-lead/[29px] font-normal tracking-[-1px]',
};
---

<span class:list={['whitespace-nowrap', variants[variant]]}>{label}</span>
