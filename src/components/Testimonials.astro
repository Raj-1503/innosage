---
import { testimonials } from '@/data/site';
import TestimonialCard from './TestimonialCard.astro';
---

<section class="relative overflow-hidden bg-white pt-30 pb-14" data-cursor="scroll" data-pin-section>
	<div class="shell">
		<div class="relative mb-16">
			<div class="max-w-180">
				<h2>Delivering excellence to our clients</h2>
				<p class="mt-6">Read what our clients have to say.</p>
			</div>
			<div
				class="mt-8 h-1.25 border-b border-ice tablet:absolute tablet:right-0 tablet:bottom-3 tablet:m-0 tablet:w-[min(608px,49%)]"
				data-pin-track
				aria-hidden="true"
			>
				<span class="block h-1 w-1/4 bg-navy" data-pin-thumb></span>
			</div>
		</div>
		<div class="-mx-(--gutter) overflow-x-auto px-(--gutter) [scrollbar-width:none] tablet:[&.pinned]:overflow-visible">
			<div
				class="flex w-max gap-6 [&>figure]:w-[min(82vw,612px)]"
				data-pin-row
				tabindex="0"
				role="group"
				aria-label="Client testimonials"
			>
				{testimonials.map((testimonial) => (
					<TestimonialCard {...testimonial} />
				))}
			</div>
		</div>
	</div>
</section>

<script>
	import '@/scripts/testimonials';
</script>
