---
import Tag from './Tag.astro';

interface Props {
	title: string;
	summary: string;
	tags: string[];
}

const { title, summary, tags } = Astro.props;
---

<article class="border-t border-ice pt-6">
	<h5>{title}</h5>
	<p class="mt-2">{summary}</p>
	<div class="mt-6 flex flex-wrap gap-x-2 gap-y-4">
		{tags.map((label) => (
			<Tag label={label} />
		))}
	</div>
</article>
