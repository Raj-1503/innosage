---
import Tag from './Tag.astro';

interface Props {
	title: string;
	summary: string;
	tags: string[];
}

const { title, summary, tags } = Astro.props;
---

<article>
	<h5>{title}</h5>
	<p>{summary}</p>
	<div class="tags">{tags.map((label) => <Tag label={label} />)}</div>
</article>

<style>
	article {
		padding-top: 24px;
		border-top: 1px solid var(--ice);
	}

	p {
		margin-top: 8px;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 16px 8px;
		margin-top: 24px;
	}
</style>
