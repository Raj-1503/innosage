---
import { Image } from 'astro:assets';
import cedar from '@/assets/site/Cedar-5.webp';
import oven from '@/assets/site/tao_food.webp';
import restaurant from '@/assets/site/Akebono-Fuji-restaurant.webp';
import poster from '@/assets/site/Poster-02.webp';
import { lightLogos } from '@/data/clients';
import { contact, nav, social } from '@/data/site';
import { tones } from '@/lib/tones';
import Marquee from './Marquee.astro';
import PillLink from './PillLink.astro';

const copy = 'text-lead/6';
const muted = 'text-nav text-body';
---

<footer class:list={['relative z-1 -mt-10 pt-10', tones.navy]}>
	<div class="grid gap-14 py-20 text-center">
		<h6>Our Clients</h6>
		<Marquee items={lightLogos} variant="logos" />
	</div>

	<div class="relative overflow-hidden pt-34 pb-12">
		<div class="pointer-events-none absolute inset-0" aria-hidden="true">
			<Image
				class="absolute top-6.5 -right-80.25 w-150 rounded-card opacity-[0.04]"
				src={cedar}
				alt=""
				width={1200}
				loading="lazy"
			/>
			<Image
				class="absolute top-28.25 -left-81.5 w-150 rounded-card opacity-[0.04]"
				src={oven}
				alt=""
				width={1200}
				loading="lazy"
			/>
			<Image
				class="absolute top-159.75 left-1/2 w-150 -translate-x-1/2 rounded-card opacity-[0.04]"
				src={restaurant}
				alt=""
				width={1200}
				loading="lazy"
			/>
			<Image
				class="absolute -top-27 left-1/2 w-82.5 -translate-x-1/2 rounded-card opacity-10"
				src={poster}
				alt=""
				width={660}
				loading="lazy"
			/>
			<span class="absolute top-0 left-0 h-48 w-full bg-linear-to-b from-navy from-16% to-transparent"></span>
			<span class="absolute bottom-0 left-0 h-48 w-full bg-linear-to-t from-navy from-37% to-transparent"></span>
		</div>

		<div class="shell relative grid gap-24">
			<section class="grid justify-items-center gap-4 text-center">
				<h1 class="text-[clamp(36px,calc(36px+var(--fluid)*4.6875),81px)]/[clamp(36px,calc(36px+var(--fluid)*5.7292),110px)]">
					Let’s talk with us
				</h1>
				<p class="mb-8 max-w-206.25">
					Contact Innosage today, and let's start the conversation about transforming your ideas into extraordinary
					digital experiences.
				</p>
				<PillLink href="/contact/" label="LET'S TALK" tone="white" size="lg" />
			</section>

			<nav class:list={['flex flex-wrap justify-center gap-x-16 gap-y-4', copy]} aria-label="Footer">
				{nav.map((item) => (
					<a class="transition-colors duration-200 hover:underline" href={item.href}>
						{item.label}
					</a>
				))}
			</nav>

			<div class:list={['-mt-8 flex flex-wrap justify-between gap-8', copy]}>
				<address class="grid gap-2 not-italic">
					<a class="transition-colors duration-200 hover:underline" href={`mailto:${contact.email}`}>
						{contact.email}
					</a>
					<a class="transition-colors duration-200 hover:underline" href={contact.phoneHref}>
						{contact.phone}
					</a>
					<small class={muted}>Contact</small>
				</address>
				<div class="grid justify-items-end gap-2">
					<div class="flex gap-6">
						{social.map((item) => (
							<a class="transition-colors duration-200 hover:underline" href={item.href} rel="noopener">
								{item.label}
							</a>
						))}
					</div>
					<small class={muted}>Social Media</small>
				</div>
			</div>

			<p class="-mt-8 text-center text-small/6 font-medium tracking-normal text-body">
				Copyright © {new Date().getFullYear()} Innosage. All rights reserved.
			</p>
		</div>
	</div>
</footer>
