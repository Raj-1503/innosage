---
import { tones, type Tone } from '@/lib/tones';

interface Props {
	tone?: Tone;
	class?: string;
}

const { tone = 'white', class: className } = Astro.props;
---

<section class:list={['relative py-(--section-y)', tones[tone]]}>
	<div class:list={['shell', className]}>
		<slot />
	</div>
</section>
