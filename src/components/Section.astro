---
interface Props {
	tone?: 'white' | 'navy' | 'ice';
	class?: string;
	id?: string;
	cursor?: 'scroll';
}

const { tone = 'white', class: className, id, cursor } = Astro.props;
---

<section class:list={[tone]} id={id} data-cursor={cursor}>
	<div class:list={['container', className]}>
		<slot />
	</div>
</section>

<style>
	section {
		position: relative;
		padding-block: var(--section-y);
	}
</style>
