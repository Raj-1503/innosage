---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blogs'>;
	variant?: 'compact' | 'full' | 'featured';
}

const { post, variant = 'full' } = Astro.props;
const { title, coverImage, excerpt, author, categories } = post.data;
---

<a class={variant} href={`/blogs/${post.id}/`} data-reveal>
	<div class="media">
		{coverImage && <Image src={coverImage} alt="" width={variant === 'featured' ? 1100 : 700} loading="lazy" />}
	</div>
	<div class="copy">
		{
			variant === 'compact' ? (
				<>
					<span class="title">{title}</span>
					<span class="by">by {author}</span>
				</>
			) : (
				<>
					<p class="meta">
						{categories.join(', ')} <span>/</span> {author}
					</p>
					{variant === 'featured' ? <h5>{title}</h5> : <span class="title">{title}</span>}
					<p class="excerpt">{excerpt}</p>
				</>
			)
		}
	</div>
</a>

<style>
	a {
		display: grid;
		align-content: start;
		gap: 24px;
	}

	.media {
		overflow: hidden;
		border-radius: var(--radius);
	}

	img {
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease-in-out;
	}

	a:hover img {
		transform: scale(1.05);
	}

	.copy {
		display: grid;
		align-content: start;
		gap: 16px;
	}

	.title {
		color: var(--ink);
		font-family: var(--heading-font);
		font-size: 18px;
		font-weight: 500;
		line-height: 1.3;
	}

	.by {
		color: #666;
		font-size: 14px;
	}

	.meta,
	.excerpt {
		font-size: 14px;
		line-height: 24px;
		letter-spacing: normal;
	}

	.meta span {
		color: var(--red);
	}

	.compact img {
		aspect-ratio: 3 / 2;
	}

	.compact .copy {
		gap: 8px;
	}

	.full img {
		aspect-ratio: 1;
	}

	.featured h5 {
		font-size: inherit;
	}

	@media (min-width: 810px) {
		.full {
			grid-template-columns: 1fr 1fr;
		}

		.featured {
			grid-template-columns: 686fr 562fr;
			align-items: center;
		}

		.featured img {
			aspect-ratio: 686 / 586;
		}

		.featured h5 {
			font-size: clamp(36px, calc(36px + var(--fluid) * 2.6042), 56px);
			line-height: clamp(36px, calc(36px + var(--fluid) * 2.6042), 56px);
			letter-spacing: -2px;
		}
	}
</style>
