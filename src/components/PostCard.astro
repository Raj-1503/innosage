---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blogs'>;
	variant?: 'compact' | 'full' | 'featured';
}

const { post, variant = 'full' } = Astro.props;
const { title, coverImage, excerpt, author, categories } = post.data;
const small = 'text-small/6 tracking-normal';
const heading = 'font-heading text-lead/[1.3] font-medium text-ink';
const layouts = {
	compact: '',
	full: 'tablet:grid-cols-2',
	featured: 'items-center tablet:grid-cols-[686fr_562fr]',
};
const ratios = {
	compact: 'aspect-3/2',
	full: 'aspect-square',
	featured: 'tablet:aspect-686/586',
};
---

<a class:list={['group grid content-start gap-6', layouts[variant]]} href={`/blogs/${post.id}/`} data-reveal>
	<div class="overflow-hidden rounded-card">
		{coverImage && (
			<Image
				class:list={[
					'h-full object-cover transition-[scale] duration-400 ease-in-out group-hover:scale-105',
					ratios[variant],
				]}
				src={coverImage}
				alt=""
				widths={[480, 700, 1100]}
				sizes={variant === 'featured' ? '(min-width: 810px) 55vw, 100vw' : '(min-width: 810px) 33vw, 100vw'}
				loading="lazy"
			/>
		)}
	</div>
	<div class:list={['grid content-start', variant === 'compact' ? 'gap-2' : 'gap-4']}>
		{variant === 'compact' ? (
			<>
				<span class={heading}>{title}</span>
				<span class="text-small text-[#666]">by {author}</span>
			</>
		) : (
			<>
				<p class={small}>
					{categories.join(', ')} <span class="text-crimson">/</span> {author}
				</p>
				{variant === 'featured' ? <h5 class="tablet:text-h3">{title}</h5> : <span class={heading}>{title}</span>}
				<p class={small}>{excerpt}</p>
			</>
		)}
	</div>
</a>
