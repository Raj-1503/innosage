---
interface Props {
	title: string;
	tagline: string;
	statement: string;
	items: { title: string; text: string }[];
}

const { title, tagline, statement, items } = Astro.props;
const group = title.replace(/\W+/g, '-').toLowerCase();
---

<div class="grid gap-8 wide:grid-cols-[2fr_3fr] wide:gap-16">
	<div>
		<h4>{title}</h4>
		<p class="mt-4">{tagline}</p>
	</div>
	<div>
		<h5>{statement}</h5>
		<div class="mt-10">
			{items.map((item, index) => (
				<details
					class="accordion border-t border-paper py-8 [interpolate-size:allow-keywords]"
					name={group}
					open={index === 0}
				>
					<summary class="flex cursor-pointer list-none items-center gap-6 font-heading text-h6/[45.5px] tracking-(--text-h6--letter-spacing) text-ink">
						{item.title}
					</summary>
					<p class="mt-3 ml-18">{item.text}</p>
				</details>
			))}
		</div>
	</div>
</div>
