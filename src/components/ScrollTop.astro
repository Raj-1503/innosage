<a
	id="scroll-top"
	class="pointer-events-none fixed right-0 bottom-31.25 z-99 flex rounded-l-[5px] bg-black/40 text-white opacity-0 transition-opacity duration-300 [&.is-visible]:pointer-events-auto [&.is-visible]:opacity-100"
	href="#"
	aria-label="Back to top"
>
	<svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		<path d="m6 15 6-6 6 6"></path>
	</svg>
</a>

<script>
	const button = document.getElementById('scroll-top');
	const update = () => button?.classList.toggle('is-visible', scrollY > 800);
	addEventListener('scroll', update, { passive: true });
	update();
	button?.addEventListener('click', (event) => {
		event.preventDefault();
		scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
	});
</script>
