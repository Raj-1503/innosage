---
import { withBase } from '@/lib/url';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
	project: CollectionEntry<'projects'>;
	description?: string;
	tags?: string[];
}

const { project, description, tags } = Astro.props;
const { title, coverImage, summary, disciplines, comingSoon } = project.data;
const text = description ?? summary ?? (comingSoon ? 'Project Coming Soon...' : '');
---

<a class="group block h-full desk:cursor-none" href={withBase(`/works/${project.id}/`)} data-cursor="arrow" data-reveal>
	<article class="flex h-full flex-col overflow-hidden rounded-tile bg-mist px-2.5 pt-2.5 pb-5">
		<div class="overflow-hidden rounded-[10px] bg-[#f5f4f3]">
			{coverImage && (
				<Image
					class="aspect-3/2 object-cover transition-[filter,scale] duration-300 ease-[ease] desk:group-hover:scale-110 desk:group-hover:blur-[3px]"
					src={coverImage}
					alt={title}
					widths={[600, 900, 1200]}
					sizes="(min-width: 810px) 50vw, 100vw"
					loading="lazy"
				/>
			)}
		</div>
		<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 px-2.5 pt-4">
			<div class="min-w-0 flex-1 basis-50">
				<h6>{title}</h6>
				{text && <p>{text}</p>}
			</div>
			<div class="flex flex-wrap gap-2.5 pt-0.5">
				{(tags ?? disciplines).map((label) => (
					<Tag label={label} variant="card" />
				))}
			</div>
		</div>
	</article>
</a>
