---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
	project: CollectionEntry<'projects'>;
	description?: string;
	maxTags?: number;
}

const { project, description, maxTags } = Astro.props;
const { title, coverImage, summary, disciplines, comingSoon } = project.data;
const text = description ?? summary ?? (comingSoon ? 'Project Coming Soon...' : '');
---

<a href={`/works/${project.id}/`} data-cursor="arrow" data-reveal>
	<article>
		<div class="media">
			{coverImage && <Image src={coverImage} alt={title} width={1200} loading="lazy" />}
		</div>
		<div class="copy">
			<div>
				<h6>{title}</h6>
				{text && <p>{text}</p>}
			</div>
			<div class="tags">
				{disciplines.slice(0, maxTags).map((label) => <Tag label={label} variant="card" />)}
			</div>
		</div>
	</article>
</a>

<style>
	a {
		display: block;
		height: 100%;
	}

	article {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		padding: 10px 10px 20px;
		border-radius: 20px;
		background: var(--mist);
	}

	.media {
		flex: 1;
		overflow: hidden;
		border-radius: 10px;
		background: #f5f4f3;
	}

	img {
		height: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		transition:
			filter 300ms ease,
			transform 300ms ease;
	}

	.copy {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 16px 10px 0;
	}

	.copy > div:first-child {
		flex: 1 1 200px;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		padding-block: 10px;
	}

	@media (min-width: 1280px) {
		a {
			cursor: none;
		}

		a:hover img {
			filter: blur(3px);
			transform: scale(1.1);
		}
	}
</style>
