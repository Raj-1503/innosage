---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getProjectThumbs } from '@/lib/content';

interface Props {
	projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const strips = projects
	.map((project) => ({ project, thumbs: getProjectThumbs(project) }))
	.filter(({ thumbs }) => thumbs.length > 0);
---

<section class="relative overflow-x-clip bg-white py-(--section-y)">
	<div class="shell">
		<h6 class="mb-16">
			<span class="text-crimson">/</span> A closer look ({strips.length})
		</h6>
		<div class="grid gap-20 tablet:gap-32">
			{strips.map(({ project, thumbs }, index) => (
				<a
					class:list={[
						'group flex flex-col gap-4 tablet:flex-row tablet:items-center tablet:justify-between tablet:gap-10',
						index % 2 === 1 && 'tablet:flex-row-reverse',
					]}
					href={`/works/${project.id}/`}
					data-strip={index % 2 === 1 ? 'right' : 'left'}
				>
					<div class="flex min-w-0 gap-2 tablet:gap-3">
						{thumbs.map((image, thumb) => (
							<Image
								class:list={[
									'h-[clamp(84px,12vw,190px)] w-auto rounded-card object-cover transition-transform duration-500 ease-fill group-hover:-translate-y-1.5',
									thumb === 1 && 'delay-75',
									thumb === 2 && 'delay-150',
								]}
								src={image}
								alt=""
								height={440}
								loading="lazy"
							/>
						))}
					</div>
					<p class="text-ink tablet:max-w-56">
						{project.data.title}, {project.data.services[0]}. {project.data.year}.
					</p>
				</a>
			))}
		</div>
	</div>
</section>
