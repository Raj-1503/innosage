---
import logoDark from '../assets/site/main-logo.svg?url';
import logoLight from '../assets/site/main-logo-light.svg?url';
import PillLink from './PillLink.astro';

interface Props {
	tone: 'white' | 'navy' | 'brand' | 'brand-dark';
	color?: string;
}

const { tone, color } = Astro.props;
const dark = tone === 'white' || tone === 'brand-dark';
const links = [
	{ label: 'Services', href: '/services/' },
	{ label: 'Works', href: '/works/' },
	{ label: 'About', href: '/about/' },
	{ label: 'Blogs', href: '/blogs/' },
];
---

<header class:list={[tone === 'white' || tone === 'navy' ? tone : '', { dark }]} style={color ? `background:${color}` : undefined}>
	<div class="container bar">
		<a href="/" aria-label="Innosage home"><img src={dark ? logoDark : logoLight} alt="" width="150" height="22" /></a>
		<button popovertarget="site-menu" aria-label="Menu">
			<span></span><span></span><span></span>
		</button>
		<nav id="site-menu" popover aria-label="Main">
			<div class="links">
				{links.map((item) => <a href={item.href}>{item.label}</a>)}
			</div>
			<PillLink href="/contact/" label="LET'S TALK" tone="glass" />
		</nav>
	</div>
</header>

<style>
	header {
		position: relative;
		z-index: 20;
		color: #fff;
	}

	.dark {
		color: #000;
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 82px;
	}

	.bar > a img {
		width: 150px;
		height: 22px;
	}

	button {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 7px;
		width: 34px;
		height: 34px;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		cursor: pointer;
	}

	button span {
		display: block;
		width: 28px;
		height: 3px;
		border-radius: 2px;
		background: currentColor;
		transition: 0.3s;
	}

	button:has(+ nav:popover-open) span:nth-child(1) {
		transform: translateY(10px) rotate(45deg);
	}

	button:has(+ nav:popover-open) span:nth-child(2) {
		opacity: 0;
	}

	button:has(+ nav:popover-open) span:nth-child(3) {
		transform: translateY(-10px) rotate(-45deg);
	}

	nav {
		position: absolute;
		inset: 82px 0 auto;
		width: 100%;
		margin: 0;
		padding: 16px var(--gutter);
		border: 0;
		border-top: 3px solid var(--accent);
		background: var(--navy);
		box-shadow: 0 6px 10px 4px rgb(0 0 0 / 0.2);
		transform: translateY(-16px);
		opacity: 0;
		transition:
			transform 0.25s cubic-bezier(0.32, 0.72, 0, 1),
			opacity 0.25s,
			display 0.25s allow-discrete,
			overlay 0.25s allow-discrete;
	}

	nav:popover-open {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		transform: none;
		opacity: 1;
	}

	@starting-style {
		nav:popover-open {
			transform: translateY(-16px);
			opacity: 0;
		}
	}

	.links {
		display: grid;
		flex: 1 1 280px;
		grid-template-columns: 1fr 1fr;
		gap: 16px 24px;
		color: #fff;
		font-size: 16px;
	}

	.links a:hover {
		color: var(--accent);
	}

	@media (min-width: 1441px) {
		.bar {
			width: 100%;
			max-width: none;
			height: 104px;
		}

		button {
			display: none;
		}

		nav {
			position: static;
			display: flex;
			align-items: center;
			gap: 74px;
			width: auto;
			padding: 0;
			border: 0;
			background: none;
			color: inherit;
			box-shadow: none;
			transform: none;
			opacity: 1;
			transition: none;
		}

		.links {
			display: flex;
			flex: none;
			gap: 48px;
			color: inherit;
			font-weight: 500;
		}

		.links a {
			transition: color 0.2s;
		}

		nav :global(a:has(.fill)) {
			font-size: 18px;
		}

		.dark nav :global(a:has(.fill)) {
			background: var(--pill);
			color: var(--ink);
		}
	}
</style>
