---
import logoDark from '@/assets/site/main-logo.svg?url';
import logoLight from '@/assets/site/main-logo-light.svg?url';
import { tones } from '@/lib/tones';
import PillLink from './PillLink.astro';

interface Props {
	tone: 'white' | 'navy' | 'brand' | 'brand-dark';
	color?: string;
}

const { tone, color } = Astro.props;
const dark = tone === 'white' || tone === 'brand-dark';
const links = [
	{ label: 'Services', href: '/services/' },
	{ label: 'Works', href: '/works/' },
	{ label: 'About', href: '/about/' },
	{ label: 'Blogs', href: '/blogs/' },
];
const bar = 'block h-0.75 w-7 rounded-xs bg-current transition-all duration-300';
---

<header
	class:list={[
		'relative z-20',
		tone === 'white' && tones.white,
		tone === 'navy' && tones.navy,
		dark ? 'text-black' : 'text-white',
	]}
	style={color ? `background:${color}` : undefined}
>
	<div class="shell flex h-20.5 items-center justify-between nav:h-26 nav:w-full nav:max-w-none">
		<a href="/" aria-label="Innosage home">
			<img class="h-5.5 w-37.5" src={dark ? logoDark : logoLight} alt="" width="150" height="22" />
		</a>
		<button
			class="flex size-8.5 cursor-pointer flex-col justify-center gap-1.75 nav:hidden"
			popovertarget="site-menu"
			aria-label="Menu"
		>
			<span
				class:list={[
					bar,
					'in-[button:has(+nav:popover-open)]:translate-y-2.5 in-[button:has(+nav:popover-open)]:rotate-45',
				]}
			></span>
			<span class:list={[bar, 'in-[button:has(+nav:popover-open)]:opacity-0']}></span>
			<span
				class:list={[
					bar,
					'in-[button:has(+nav:popover-open)]:-translate-y-2.5 in-[button:has(+nav:popover-open)]:-rotate-45',
				]}
			></span>
		</button>
		<nav
			id="site-menu"
			popover
			aria-label="Main"
			class="absolute inset-x-0 top-20.5 bottom-auto m-0 w-full -translate-y-4 border-t-3 border-accent bg-navy px-(--gutter) py-4 opacity-0 shadow-[0_6px_10px_4px_rgb(0_0_0/0.2)] transition-[translate,opacity,display,overlay] transition-discrete duration-250 ease-menu open:flex open:translate-y-0 open:flex-wrap open:items-center open:justify-between open:gap-6 open:opacity-100 starting:open:-translate-y-4 starting:open:opacity-0 nav:static nav:flex nav:w-auto nav:translate-y-0 nav:items-center nav:gap-18.5 nav:border-0 nav:bg-transparent nav:p-0 nav:text-inherit nav:opacity-100 nav:shadow-none nav:transition-none"
		>
			<div class="grid flex-[1_1_280px] grid-cols-2 gap-x-6 gap-y-4 text-nav text-white nav:flex nav:flex-none nav:gap-12 nav:text-inherit">
				{links.map((item) => (
					<a class="transition-colors duration-200 hover:text-accent" href={item.href}>
						{item.label}
					</a>
				))}
			</div>
			<PillLink
				href="/contact/"
				label="LET'S TALK"
				tone="glass"
				class:list={['nav:text-lead', dark && 'nav:bg-pill nav:text-ink']}
			/>
		</nav>
	</div>
</header>

<script>
	// Safari before 17 has no popover support, so toggle the menu by hand there.
	if (!('popover' in HTMLElement.prototype)) {
		const menu = document.getElementById('site-menu');
		document
			.querySelector('[popovertarget="site-menu"]')
			?.addEventListener('click', () => menu?.toggleAttribute('open'));
	}
</script>
