---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	name: string;
	role: string;
	photo: ImageMetadata;
}

const { name, role, photo } = Astro.props;
---

<article>
	<Image
		class="mb-5 aspect-397/438 rounded-card object-cover grayscale"
		src={photo}
		alt={name}
		widths={[400, 800]}
		sizes="(min-width: 1100px) 397px, 50vw"
		loading="lazy"
		data-reveal
	/>
	<h6>{name}</h6>
	<p>{role}</p>
</article>
