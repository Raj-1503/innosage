---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	role: string;
	photo: ImageMetadata;
}

const { name, role, photo } = Astro.props;
---

<article>
	<Image class="grayscale" src={photo} alt={name} width={800} loading="lazy" data-reveal />
	<h6>{name}</h6>
	<p>{role}</p>
</article>

<style>
	img {
		aspect-ratio: 397 / 438;
		object-fit: cover;
		border-radius: var(--radius);
		margin-bottom: 20px;
	}
</style>
