---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	role: string;
	photo: ImageMetadata;
}

const { name, role, photo } = Astro.props;
---

<article>
	<Image src={photo} alt={name} width={640} loading="lazy" />
	<h6>{name}</h6>
	<p>{role}</p>
</article>

<style>
	img {
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: var(--radius);
		margin-bottom: 1.25rem;
	}

	p {
		margin-top: 0.5rem;
		font-size: 0.875rem;
	}
</style>
