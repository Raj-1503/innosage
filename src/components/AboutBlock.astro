---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<article>
	<h6><span>■</span> {title}</h6>
	<div>
		<slot />
	</div>
</article>

<style>
	article {
		display: grid;
		gap: 24px;
		margin-top: 64px;
	}

	span {
		color: var(--accent);
		font-size: 0.5em;
		vertical-align: middle;
	}

	div {
		display: grid;
		gap: 12px;
	}

	div :global(p),
	div :global(li) {
		color: #fff;
	}

	div :global(ul) {
		padding-left: 18px;
		list-style: disc;
	}

	div :global(strong) {
		font-weight: 600;
	}
</style>
