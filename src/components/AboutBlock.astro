---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<article class="mt-16 grid gap-6">
	<h6>
		<span class="align-middle text-[0.5em] text-accent">■</span> {title}
	</h6>
	<div class="grid gap-3 [&_li]:text-white [&_p]:text-white [&_strong]:font-semibold [&_ul]:list-disc [&_ul]:pl-4.5">
		<slot />
	</div>
</article>
