---
import { contact, contactServices } from '@/data/site';

// Static hosting has no server, so set PUBLIC_FORM_ENDPOINT to a form service.
// Without one, the form opens the visitor's email app instead.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
const formProps = endpoint ? { action: endpoint } : { action: `mailto:${contact.email}`, enctype: 'text/plain' };
const field =
	'mb-3.5 w-full resize-y rounded-none border-b-2 border-[#d1d5db] bg-transparent pt-2.5 pb-3 font-sans text-small/[1.6] font-normal text-[#0b0b0b] outline-none transition-[border-color,box-shadow] duration-200 ease-[ease] placeholder:text-[#6b7280] placeholder:opacity-100 focus-visible:border-[#0b0b0b] focus-visible:shadow-[0_2px_0_0_#0b0b0b]';
---

<form class="flex flex-col gap-[clamp(20px,3vw,40px)] wide:flex-row wide:items-start" method="post" {...formProps}>
	<div class="wide:flex-[0_0_40%]">
		<h5>Tell us what do you need..</h5>
		<fieldset class="mt-8 flex flex-wrap gap-4.5">
			<legend class="sr-only">Select one or more services</legend>
			{contactServices.map((service) => (
				<label>
					<input class="peer absolute opacity-0" type="checkbox" name="services" value={service} />
					<span class="inline-flex min-h-11 cursor-pointer items-center justify-center rounded-full border-[1.5px] border-[#0b0b0b] bg-white px-4.5 py-2.5 text-small text-[#0b0b0b] transition-[background-color,color,border-color,box-shadow] duration-200 ease-[ease] select-none peer-checked:bg-[#0b0b0b] peer-checked:text-white peer-focus-visible:shadow-[0_0_0_3px_rgb(255_74_26/0.35)]">
						{service}
					</span>
				</label>
			))}
		</fieldset>
	</div>
	<div class="flex flex-col gap-[clamp(16px,2.2vw,22px)] wide:flex-[1_1_60%]">
		<input
			class={field}
			type="text"
			name="name"
			placeholder="What’s your name?"
			aria-label="Your name"
			autocomplete="name"
			required
		/>
		<input
			class={field}
			type="email"
			name="email"
			placeholder="What’s your email address?"
			aria-label="Your email address"
			autocomplete="email"
			required
		/>
		<input
			class={field}
			type="text"
			name="company"
			placeholder="What’s your company name?"
			aria-label="Your company name"
			autocomplete="organization"
		/>
		<textarea
			class={field}
			name="message"
			rows="5"
			placeholder="Tell us about your project here.."
			aria-label="About your project"
		></textarea>
		<button
			class="mt-1.5 w-fit cursor-pointer rounded-full bg-[#ff4a1a] px-15 py-6 font-sans text-small/[1.6] font-semibold text-white transition-[filter,box-shadow] duration-200 ease-[ease] hover:brightness-94"
			type="submit"
		>
			Send Message
		</button>
	</div>
</form>
