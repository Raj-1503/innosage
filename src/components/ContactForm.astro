---
import { contact, contactServices } from '../data/site';

// Static hosting has no server, so set PUBLIC_FORM_ENDPOINT to a form service.
// Without one, the form opens the visitor's email app instead.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
const formProps = endpoint
	? { action: endpoint }
	: { action: `mailto:${contact.email}`, enctype: 'text/plain' };
---

<form method="post" {...formProps}>
	<div class="left">
		<h5>Tell us what do you need..</h5>
		<fieldset>
			<legend>Select one or more services</legend>
			{
				contactServices.map((service) => (
					<label class="chip">
						<input type="checkbox" name="services" value={service} />
						<span>{service}</span>
					</label>
				))
			}
		</fieldset>
	</div>
	<div class="right">
		<input type="text" name="name" placeholder="What’s your name?" aria-label="Your name" required />
		<input type="email" name="email" placeholder="What’s your email address?" aria-label="Your email address" required />
		<input type="text" name="company" placeholder="What’s your company name?" aria-label="Your company name" />
		<textarea name="message" rows="5" placeholder="Tell us about your project here.." aria-label="About your project"></textarea>
		<button type="submit">Send Message</button>
	</div>
</form>

<style>
	form {
		display: flex;
		flex-direction: column;
		gap: clamp(20px, 3vw, 40px);
	}

	fieldset {
		display: flex;
		flex-wrap: wrap;
		gap: 18px;
		margin: 32px 0 0;
		padding: 0;
		border: 0;
	}

	legend {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
	}

	.chip input {
		position: absolute;
		opacity: 0;
	}

	.chip span {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 10px 18px;
		border: 1.5px solid #0b0b0b;
		border-radius: 999px;
		background: #fff;
		color: #0b0b0b;
		font-size: 14px;
		cursor: pointer;
		user-select: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.chip input:checked + span {
		border-color: #0b0b0b;
		background: #0b0b0b;
		color: #fff;
	}

	.chip input:focus-visible + span {
		box-shadow: 0 0 0 3px color-mix(in srgb, #ff4a1a 35%, transparent);
	}

	.right {
		display: flex;
		flex-direction: column;
		gap: clamp(16px, 2.2vw, 22px);
	}

	input[type='text'],
	input[type='email'],
	textarea {
		width: 100%;
		margin-bottom: 14px;
		padding: 10px 0 12px;
		border: 0;
		border-bottom: 2px solid #d1d5db;
		border-radius: 0;
		outline: none;
		background: transparent;
		color: #0b0b0b;
		font: 400 14px/1.6 'Inter Variable', sans-serif;
		resize: vertical;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	::placeholder {
		color: #6b7280;
		opacity: 1;
	}

	input:focus-visible,
	textarea:focus-visible {
		border-color: #0b0b0b;
		box-shadow: 0 2px 0 0 #0b0b0b;
	}

	button {
		width: fit-content;
		margin-top: 6px;
		padding: 24px 60px;
		border: 0;
		border-radius: 999px;
		background: #ff4a1a;
		color: #fff;
		font: 600 14px/1.6 'Inter Variable', sans-serif;
		cursor: pointer;
		transition:
			filter 0.2s ease,
			box-shadow 0.2s ease;
	}

	button:hover {
		filter: brightness(0.94);
	}

	@media (min-width: 1440px) {
		form {
			flex-direction: row;
			align-items: flex-start;
		}

		.left {
			flex: 0 0 40%;
		}

		.right {
			flex: 1 1 60%;
		}
	}
</style>
