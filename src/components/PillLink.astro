---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
	href: string;
	label: string;
	tone?: 'pale' | 'white' | 'glass';
	size?: 'md' | 'lg';
}

const { href, label, tone = 'pale', size = 'md', class: className } = Astro.props;
const tones = {
	pale: 'bg-pill text-ink',
	white: 'bg-white text-ink',
	glass: 'bg-white/10 text-white',
};
const sizes = {
	md: 'h-14 text-nav [--dot:40px]',
	lg: 'h-17 text-lead [--dot:52px]',
};
---

<a
	class:list={[
		'group relative inline-flex w-fit items-center gap-4 overflow-hidden rounded-full py-2 pr-2 pl-6 font-medium whitespace-nowrap',
		tones[tone],
		sizes[size],
		className,
	]}
	href={href}
>
	<span
		class="absolute top-1/2 right-2 size-(--dot) -translate-y-1/2 rounded-full bg-accent transition-[width,height,right] duration-400 ease-fill desk:group-hover:right-0 desk:group-hover:size-100"
		aria-hidden="true"
	></span>
	<span class="relative">{label}</span>
	<span class="relative grid size-(--dot) place-items-center text-ink" aria-hidden="true">
		<svg
			class="size-4.5 -rotate-45 transition-[rotate] duration-300 ease-in-out group-hover:rotate-0"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
		>
			<path d="M4 12h16M13 5l7 7-7 7"></path>
		</svg>
	</span>
</a>
