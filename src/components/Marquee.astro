---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	items: { src: ImageMetadata; alt: string }[];
	variant: 'logos' | 'gallery';
	reverse?: boolean;
}

const { items, variant, reverse = false } = Astro.props;
---

<div class:list={['marquee', variant, { reverse }]}>
	<div class="track">
		{
			[false, true].map((copy) => (
				<ul aria-hidden={copy ? 'true' : undefined}>
					{items.map((item) => (
						<li>
							<Image src={item.src} alt={copy ? '' : item.alt} height={variant === 'logos' ? 112 : 700} loading="lazy" />
						</li>
					))}
				</ul>
			))
		}
	</div>
</div>

<style>
	.marquee {
		--gap: 32px;
		overflow: hidden;
	}

	.track {
		display: flex;
		width: max-content;
		will-change: transform;
		animation: slide var(--duration) linear infinite;
	}

	.reverse .track {
		animation-direction: reverse;
	}

	ul {
		display: flex;
		align-items: center;
		gap: var(--gap);
		padding-right: var(--gap);
	}

	.gallery {
		--duration: 30s;
		--height: 350px;
		mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
	}

	.gallery img {
		width: auto;
		height: var(--height);
		object-fit: cover;
		border-radius: var(--radius);
	}

	.logos {
		--duration: 40s;
	}

	.logos li {
		display: grid;
		place-items: center;
		width: 200px;
	}

	.logos img {
		width: auto;
		max-width: 100%;
		height: 56px;
		object-fit: contain;
	}

	@media (max-width: 980px) {
		.gallery {
			--gap: 24px;
			--height: 260px;
		}
	}

	@media (max-width: 767px) {
		.gallery {
			--gap: 16px;
			--height: 180px;
		}
	}

	@keyframes slide {
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}
</style>
