---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	items: { src: ImageMetadata; alt: string }[];
	variant: 'logos' | 'gallery';
	reverse?: boolean;
}

const { items, variant, reverse = false } = Astro.props;
const logos = variant === 'logos';
---

<div
	class:list={[
		'marquee overflow-hidden [--gap:32px]',
		logos
			? '[--duration:40s]'
			: '[--duration:30s] [--height:350px] mask-x-from-90% mask-x-to-100% max-[980px]:[--gap:24px] max-[980px]:[--height:260px] max-[767px]:[--gap:16px] max-[767px]:[--height:180px]',
	]}
>
	<div
		class:list={[
			'flex w-max animate-marquee [animation-duration:var(--duration)] will-change-transform',
			reverse && '[animation-direction:reverse]',
		]}
	>
		{[false, true].map((copy) => (
			<ul class="flex items-center gap-(--gap) pr-(--gap)" aria-hidden={copy ? 'true' : undefined}>
				{items.map((item) => (
					<li class:list={[logos && 'grid w-50 place-items-center']}>
						<Image
							class:list={[
								'w-auto',
								logos ? 'h-14 max-w-full object-contain' : 'h-(--height) rounded-card object-cover',
							]}
							src={item.src}
							alt={copy ? '' : item.alt}
							height={logos ? 112 : 700}
							loading="lazy"
						/>
					</li>
				))}
			</ul>
		))}
	</div>
</div>
