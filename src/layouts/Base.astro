---
import '@fontsource-variable/inter';
import '@fontsource-variable/work-sans';
import '../styles/global.css';
import CustomCursor from '../components/CustomCursor.astro';
import Footer from '../components/Footer.astro';
import Grain from '../components/Grain.astro';
import Header from '../components/Header.astro';
import ScrollTop from '../components/ScrollTop.astro';

interface Props {
	title: string;
	description?: string;
	headerTone?: 'white' | 'navy' | 'brand' | 'brand-dark';
	headerColor?: string;
}

const { title, description, headerTone = 'white', headerColor } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<title>{title}</title>
	</head>
	<body>
		<Header tone={headerTone} color={headerColor} />
		<main>
			<slot />
		</main>
		<Footer />
		<ScrollTop />
		<CustomCursor />
		<Grain />
		<script>
			import '../scripts/reveal';
		</script>
		<style>
			main {
				position: relative;
				z-index: 2;
			}

			main > :global(:last-child) {
				border-radius: 0 0 40px 40px;
			}
		</style>
	</body>
</html>
