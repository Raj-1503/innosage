---
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import Section from '../../components/Section.astro';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/content';

const lede = 'Insights, work approaches, ideas. Read it all.';
const [latest, ...rest] = await getPosts();
---

<Base title="Blogs | Innosage" description={lede}>
	<PageHero title="Article & News" lede={lede} rule>
		<div class="latest">
			{latest && <PostCard post={latest} variant="featured" />}
		</div>
	</PageHero>
	<Section class="posts">
		{rest.map((post) => <PostCard post={post} />)}
	</Section>
</Base>

<style>
	.latest {
		margin-top: 64px;
	}

	:global(.posts) {
		display: grid;
		gap: 64px 48px;
	}

	@media (min-width: 1100px) {
		:global(.posts) {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
