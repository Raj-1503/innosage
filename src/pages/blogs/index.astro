---
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import Section from '../../components/Section.astro';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/content';

const lede = 'Insights, work approaches, ideas. Read it all.';
const [latest, ...rest] = await getPosts();
---

<Base title="Blogs | Innosage" description={lede}>
	<PageHero title="Article & News" lede={lede} />
	<Section>
		{latest && <PostCard post={latest} variant="featured" />}
		<div class="cards">
			{rest.map((post) => <PostCard post={post} />)}
		</div>
	</Section>
</Base>
