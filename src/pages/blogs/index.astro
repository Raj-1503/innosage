---
import PageHero from '@/components/PageHero.astro';
import PostCard from '@/components/PostCard.astro';
import Section from '@/components/Section.astro';
import Base from '@/layouts/Base.astro';
import { getPosts } from '@/lib/content';

const lede = 'Insights, work approaches, ideas. Read it all.';
const [latest, ...rest] = await getPosts();
---

<Base title="Blogs | Innosage" description={lede}>
	<PageHero title="Article & News" lede={lede} rule>
		<div class="mt-16">{latest && <PostCard post={latest} variant="featured" />}</div>
	</PageHero>
	<Section class="grid gap-x-12 gap-y-16 lap:grid-cols-2">
		{rest.map((post) => (
			<PostCard post={post} />
		))}
	</Section>
</Base>
