---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Prose from '../../components/Prose.astro';
import Section from '../../components/Section.astro';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/content';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, excerpt, coverImage, publishedDate, author, categories } = post.data;
---

<Base title={`${title} | Innosage`} description={excerpt}>
	<Section>
		<article>
			<header>
				<p>{categories.join(', ')} / {author}</p>
				<h1>{title}</h1>
				<time datetime={publishedDate.toISOString()}>
					{publishedDate.toLocaleDateString('en-GB', { dateStyle: 'long' })}
				</time>
			</header>
			{coverImage && <Image src={coverImage} alt="" width={1400} />}
			<Prose>
				<Content />
			</Prose>
		</article>
	</Section>
</Base>

<style>
	header {
		display: grid;
		gap: 1.25rem;
		max-width: 62rem;
		margin-bottom: 3rem;
	}

	h1 {
		font-size: clamp(2.25rem, 5vw, 4.5rem);
	}

	article > :global(img) {
		margin-bottom: 3rem;
		border-radius: var(--radius);
	}
</style>
