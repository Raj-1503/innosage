---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Prose from '../../components/Prose.astro';
import Section from '../../components/Section.astro';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/content';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, excerpt, coverImage, publishedDate, author, categories } = post.data;
---

<Base title={`${title} | Innosage`} description={excerpt}>
	<Section>
		<article>
			<header>
				<p>{categories.join(', ')} <span>/</span> {author}</p>
				<h2>{title}</h2>
				<time datetime={publishedDate.toISOString()}>
					{publishedDate.toLocaleDateString('en-GB', { dateStyle: 'long' })}
				</time>
			</header>
			{coverImage && <Image src={coverImage} alt="" width={1600} />}
			<Prose>
				<Content />
			</Prose>
		</article>
	</Section>
</Base>

<style>
	header {
		display: grid;
		gap: 16px;
		max-width: 1000px;
		margin-bottom: 48px;
	}

	header span {
		color: var(--red);
	}

	article > :global(img) {
		margin-bottom: 64px;
		border-radius: var(--radius);
	}
</style>
