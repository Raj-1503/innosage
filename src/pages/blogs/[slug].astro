---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Prose from '@/components/Prose.astro';
import Section from '@/components/Section.astro';
import Base from '@/layouts/Base.astro';
import { getPosts } from '@/lib/content';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, excerpt, coverImage, publishedDate, author, categories } = post.data;
---

<Base title={`${title} | Innosage`} description={excerpt} image={coverImage} type="article">
	<Section>
		<article>
			<header class="mb-12 grid max-w-250 gap-4">
				<p>
					{categories.join(', ')} <span class="text-crimson">/</span> {author}
				</p>
				<h2>{title}</h2>
				<time datetime={publishedDate.toISOString()}>
					{publishedDate.toLocaleDateString('en-GB', { dateStyle: 'long' })}
				</time>
			</header>
			{coverImage && (
				<Image
					class="mb-16 rounded-card"
					src={coverImage}
					alt=""
					widths={[800, 1248, 1600]}
					sizes="(min-width: 1440px) 1248px, 100vw"
				/>
			)}
			<Prose>
				<Content />
			</Prose>
		</article>
	</Section>
</Base>
