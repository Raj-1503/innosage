---
import { Image } from 'astro:assets';
import akriti from '@/assets/site/ab-pic.jpg';
import arvind from '@/assets/site/am-pic.jpg';
import brew from '@/assets/site/alchemy_brew_27.webp';
import coffee from '@/assets/site/Coffee_1.webp';
import office from '@/assets/site/innosage-office.webp';
import immunoCover from '@/assets/site/tic_40.webp';
import immunoDetail from '@/assets/site/tic_13.webp';
import FeatureCard from '@/components/FeatureCard.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Base from '@/layouts/Base.astro';

const gallery = [
	{ src: office, alt: 'The Innosage office', gray: true },
	{ src: brew, alt: 'Alchemy Brew cans' },
	{ src: akriti, alt: 'Akriti Bhalla', gray: true },
	{ src: immunoCover, alt: 'The Immuno Co. packaging' },
	{ src: immunoDetail, alt: 'The Immuno Co. packaging detail' },
	{ src: coffee, alt: 'The Alchemist’s Oven coffee cup' },
];

const perks = [
	{
		title: 'Real Work, Real Brands',
		text: "You won't be pushing pixels on mockups that never ship. At Innosage, you work on actual brand projects strategy, identity, packaging, campaigns for real founders building real businesses.",
	},
	{
		title: 'Career Growth',
		text: "We're a small studio, which means you learn fast and own your work. There are no silos here you'll move across strategy, design, and execution, and you'll understand why every decision gets made.",
	},
	{
		title: 'Collaborative Team',
		text: 'We think out loud. Innosage is a place where strategy and design sit in the same room and the best idea wins, regardless of where it came from.',
	},
];
---

<Base title="Careers | Innosage">
	<PageHero title="Explore Exciting Opportunities at Innosage">
		<div class="mt-12 grid max-w-250 gap-6">
			<h3>
				We believe in fostering a dynamic and collaborative work environment that empowers our team to create digital
				excellence.
			</h3>
			<p>Join us on this journey of creativity, growth, and meaningful impact.</p>
		</div>
	</PageHero>

	<div class="relative bg-white pt-12.25 pb-30">
		<div class="shell grid grid-cols-2 gap-6 tablet:grid-cols-3">
			{gallery.map((item) => (
				<Image
					class:list={['aspect-400/337 rounded-card object-cover', item.gray && 'grayscale']}
					src={item.src}
					alt={item.alt}
					widths={[450, 900]}
					sizes="(min-width: 810px) 33vw, 50vw"
					loading="lazy"
					data-reveal
				/>
			))}
		</div>
	</div>

	<Section tone="navy">
		<SectionHeading
			title="Current openings"
			lede="If you think you might be a good fit for our team, we’d love to hear from you!"
		/>
	</Section>

	<Section>
		<SectionHeading title="Why Join Innosage?" />
		<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-6">
			{perks.map((perk) => (
				<FeatureCard {...perk} />
			))}
		</div>
	</Section>

	<Section class="grid gap-8 tablet:grid-cols-[1fr_3fr]">
		<h6>What Our Team Says</h6>
		<div>
			<blockquote>
				<h5>
					"Working at Innosage has been a transformative experience. The collaborative atmosphere and challenging
					projects have fueled my growth."
				</h5>
			</blockquote>
			<div class="mt-12 flex items-end justify-between gap-6">
				<div>
					<h6>Arvind Mehra</h6>
					<p>Brand Systems Advisor</p>
				</div>
				<Image
					class="aspect-square w-24 rounded-card object-cover grayscale"
					src={arvind}
					alt="Arvind Mehra"
					width={192}
					loading="lazy"
				/>
			</div>
		</div>
	</Section>
</Base>
