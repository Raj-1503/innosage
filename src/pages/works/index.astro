---
import ProjectIndex from '@/components/ProjectIndex.astro';
import ProjectStrips from '@/components/ProjectStrips.astro';
import WorkIntro from '@/components/WorkIntro.astro';
import Base from '@/layouts/Base.astro';
import { getFeaturedProjects, getProjects } from '@/lib/content';

const lede = "We work with founders and growing brands to build identities that actually stick. Here's the proof.";
const featured = await getFeaturedProjects();
const projects = await getProjects();
---

<Base title="Works | Innosage" description={lede}>
	<WorkIntro lede={lede} projects={featured} />
	<ProjectIndex projects={projects} />
	<ProjectStrips projects={projects} />
</Base>

<script>
	import '@/scripts/works';
</script>
