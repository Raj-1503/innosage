---
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import Section from '../../components/Section.astro';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';

const lede = "We work with founders and growing brands to build identities that actually stick. Here's the proof.";
const projects = await getProjects();
---

<Base title="Works | Innosage" description={lede}>
	<PageHero align="center" title="Crafting cohesion from complexity" lede={lede} />
	<Section>
		<ProjectGrid>
			{projects.map((project) => <ProjectCard project={project} />)}
		</ProjectGrid>
	</Section>
</Base>
