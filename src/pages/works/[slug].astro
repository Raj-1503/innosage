---
import { render } from 'astro:content';
import CaseStudy from '@/components/CaseStudy.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ProjectHero from '@/components/ProjectHero.astro';
import ProjectOverview from '@/components/ProjectOverview.astro';
import Section from '@/components/Section.astro';
import TestimonialCard from '@/components/TestimonialCard.astro';
import Base from '@/layouts/Base.astro';
import { getProjects } from '@/lib/content';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project, index) => ({
		params: { slug: project.id },
		props: { project, next: projects[(index + 1) % projects.length] },
	}));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<Base
	title={`${data.seoTitle ?? data.title} | Innosage`}
	description={data.summary ?? data.overview}
	image={data.coverImage}
	type="article"
	headerTone={data.heroTextDark ? 'brand-dark' : 'brand'}
	headerColor={data.heroColor}
>
	<ProjectHero project={project} />
	<Section>
		<ProjectOverview
			overview={data.overview}
			comingSoon={data.comingSoon}
			client={data.client}
			services={data.services}
		/>
		<CaseStudy>
			<Content />
		</CaseStudy>
		{data.testimonial?.quote && (
			<div class="mt-20 grid gap-8">
				<h5>Testimonials</h5>
				<TestimonialCard quote={data.testimonial.quote} name={data.testimonial.name} role={data.testimonial.role} />
			</div>
		)}
		<div class="mt-24 grid gap-10 text-center [&_article]:text-left">
			<h2>What's Next?</h2>
			<ProjectCard project={next} />
		</div>
	</Section>
</Base>
