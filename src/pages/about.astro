---
import { Image } from 'astro:assets';
import oven from '@/assets/site/tao_food.webp';
import brew from '@/assets/site/alchemy_brew_23.webp';
import immuno from '@/assets/site/tic_30.webp';
import AboutBlock from '@/components/AboutBlock.astro';
import PageHero from '@/components/PageHero.astro';
import PersonRow from '@/components/PersonRow.astro';
import PillLink from '@/components/PillLink.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import TeamCard from '@/components/TeamCard.astro';
import { darkLogos } from '@/data/clients';
import { freelancers, team } from '@/data/team';
import Base from '@/layouts/Base.astro';
import { tones } from '@/lib/tones';

const group = 'mt-16 grid gap-8 lap:grid-cols-[1fr_824fr] lap:[&>:first-child]:w-98 lap:[&>:first-child]:max-w-[26vw]';
const collage = [
	{ src: immuno, alt: 'The Immuno Co. packaging' },
	{ src: brew, alt: 'Alchemy Brew cans' },
	{ src: oven, alt: 'The Alchemist’s Oven food packaging' },
];
---

<Base title="About | Innosage" headerTone="navy">
	<PageHero tone="navy" title="We're a branding studio based in New Delhi" />
	<section class:list={['relative pb-30', tones.navy]}>
		<div class="shell grid gap-12 lap:grid-cols-[1fr_2fr] lap:gap-16">
			<div class="grid grid-cols-3 content-start gap-6 lap:grid-cols-1">
				{collage.map((item) => (
					<Image
						class="aspect-4/5 rounded-card object-cover"
						src={item.src}
						alt={item.alt}
						widths={[400, 800]}
						sizes="(min-width: 1100px) 33vw, 33vw"
						data-reveal
					/>
				))}
			</div>
			<div>
				<h3>At Innosage, we build brands that are clear, consistent, and designed to grow.</h3>
				<p class="mt-6">
					From strategy to design to storytelling—we help brands feel true, look sharp, and connect with people.
				</p>

				<AboutBlock title="About Innosage">
					<p>
						At Innosage, we help businesses build clear, consistent, and memorable brands that truly connect. We work
						closely with you to shape how your brand looks, sounds, and feels—so it tells the right story to the right
						audience.
					</p>
					<p>
						Whether it’s your visual identity, packaging, or brand messaging, we bring structure and clarity that makes
						your brand easier to understand and harder to forget. We bridge the gap between where your brand is today
						and where it needs to be—with confidence and purpose.
					</p>
				</AboutBlock>
				<AboutBlock title="Our Mission">
					<p>
						To help businesses show up with intention. We create brand systems that align how you present yourself with
						who you really are—across every platform and touchpoint.
					</p>
				</AboutBlock>
				<AboutBlock title="Our Journey">
					<p>
						Innosage started with a simple question: Why do so many good businesses struggle to communicate their value?
					</p>
					<p>
						We saw great products failing to stand out—because their message wasn’t clear or consistent. So we set out
						to change that.
					</p>
					<p>
						From startups to growing D2C brands, we now help businesses tell their story with honesty, strategy, and
						visual precision.
					</p>
				</AboutBlock>
				<AboutBlock title="Why Choose Innosage">
					<p>
						<strong>A great brand isn’t just about looking good—it’s about being understood.</strong> We combine
						strategy, design, and storytelling to help you show up with clarity, confidence, and consistency.
					</p>
					<p>We step in when:</p>
					<ul>
						<li>Your brand feels confusing or inconsistent</li>
						<li>You’re entering a new market and don’t know how to position</li>
						<li>Your packaging doesn’t reflect the quality of your product</li>
						<li>You’re launching something new and need a strong start</li>
						<li>You’ve grown fast, but your brand hasn’t caught up</li>
					</ul>
					<p>
						We’re the bridge that takes your brand from confusion to clarity—and from being just another name to
						becoming a brand people trust.
					</p>
				</AboutBlock>
				<AboutBlock title="Our Vision">
					<p>Most businesses aren’t struggling with their product—they’re struggling with how they present it.</p>
					<p>
						Our vision is to help brands cut through the noise—by aligning who they are with how they show up. We
						believe great brands are built with clarity, strategy, and truth. When your brand looks right, sounds true,
						and feels aligned—growth follows naturally.
					</p>
					<p>
						We’re here to build brands that last. <strong>Thoughtful. True. Timeless.</strong>
					</p>
				</AboutBlock>
			</div>
		</div>
	</section>

	<Section>
		<SectionHeading
			title="Make some noise for our talented team."
			lede="Get to know the people that get it all done."
		/>
		<div class={group}>
			<h6>
				<span class="text-crimson">/</span> Our Team
			</h6>
			<div class="grid grid-cols-2 gap-x-7.5 gap-y-12">
				{team.map((member) => (
					<TeamCard {...member} />
				))}
			</div>
		</div>
		<div class={group}>
			<h6>
				<span class="text-crimson">/</span> Freelance Talents
			</h6>
			<div>
				{freelancers.map((person) => (
					<PersonRow {...person} />
				))}
			</div>
		</div>
		<div class={group}>
			<div></div>
			<div class="-mt-16 flex flex-wrap items-center justify-between gap-6 py-12">
				<div>
					<p>Are you the next one?</p>
					<h3>Join our team.</h3>
				</div>
				<PillLink href="/careers/" label="SEE ALL OPENINGS" />
			</div>
		</div>
	</Section>

	<Section tone="ice">
		<ul class="grid grid-cols-2 items-center gap-x-8 gap-y-12 tablet:grid-cols-4">
			{darkLogos.map((logo) => (
				<li>
					<Image
						class="mx-auto max-h-18 w-auto max-w-full object-contain"
						src={logo.src}
						alt={logo.alt}
						height={120}
						loading="lazy"
					/>
				</li>
			))}
		</ul>
	</Section>
</Base>
