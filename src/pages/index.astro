---
import { Image } from 'astro:assets';
import office from '../assets/site/innosage-office.webp';
import PageHero from '../components/PageHero.astro';
import PillLink from '../components/PillLink.astro';
import PostCard from '../components/PostCard.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceSummary from '../components/ServiceSummary.astro';
import StatCard from '../components/StatCard.astro';
import Testimonials from '../components/Testimonials.astro';
import Video from '../components/Video.astro';
import { services } from '../data/services';
import { stats } from '../data/site';
import Base from '../layouts/Base.astro';
import { getFeaturedProjects, getPosts } from '../lib/content';

const lede =
	"People buy from brands they instantly recognize. We combine honest creativity with smart technology to give your business an undeniable look and a voice people actually trust—whether it's on a physical package or a digital screen.";
const featured = await getFeaturedProjects();
const posts = (await getPosts()).slice(0, 3);
---

<Base title="Innosage | Brand strategy and design, built to last." description={lede} headerTone="navy">
	<PageHero
		tone="navy"
		align="center"
		tight
		title="Becoming a trusted brand takes design, storytelling, strategy. We handle it all."
		lede={lede}
	/>
	<div class="stage">
		<div class="navy reel">
			<div class="container">
				<div class="frame">
					<Video src="/videos/Innosage-Brand-Promo.webm" />
				</div>
			</div>
		</div>

		<div class="over">
			<Section class="about">
				<SectionHeading title="About Us" action={{ href: '/about/', label: 'ABOUT US' }} />
				<div class="about-body">
					<Image class="grayscale" src={office} alt="The Innosage office" width={900} loading="lazy" data-reveal />
					<div>
						<h5>We are dedicated to elevating brands and transforming perspectives.</h5>
						<p>
							At Innosage, we go beyond traditional consulting. Our expertise spans across design, digital
							innovation, marketing, communication, and brand consultation. We craft customized strategies
							that drive extraordinary growth and generate high demand for our clients.
						</p>
					</div>
				</div>
			</Section>
		</div>
	</div>

	<div class="panel">
		<Section>
			<h2 class="centered">Featured Portfolio</h2>
			<ProjectGrid projects={featured} />
			<div class="more">
				<div>
					<p>Can't get enough?</p>
					<h4>Get ready to see more..</h4>
				</div>
				<PillLink href="/works/" label="ALL PROJECTS" />
			</div>
		</Section>

		<Section>
			<SectionHeading
				title="Ambition and dedication for the attention to detail."
				lede="Strategic Design, Flawless Development, Unmatched Results"
				action={{ href: '/services/', label: 'SERVICE DETAILS' }}
			/>
			<div class="cards">
				{services.map((service) => <ServiceSummary {...service} />)}
			</div>
		</Section>

		<Testimonials />

		<Section class="stats">
			{stats.map((stat) => <StatCard {...stat} />)}
		</Section>

		<Section>
			<SectionHeading
				level="h4"
				title="Insights to keep you moving forward"
				action={{ href: '/blogs/', label: 'ALL INSIGHTS' }}
			/>
			<div class="cards">
				{posts.map((post) => <PostCard post={post} variant="compact" />)}
			</div>
		</Section>
	</div>
</Base>

<style>
	.reel {
		position: sticky;
		top: 0;
		z-index: 1;
		padding-block: 40px var(--section-y);
	}

	.frame {
		border: 4px solid var(--paper);
		border-radius: var(--radius);
		box-shadow: 0 0 14px rgb(244 243 239 / 0.3);
	}

	.reel :global(video) {
		aspect-ratio: 1.25;
		object-fit: cover;
		border-radius: var(--radius);
	}

	.over {
		position: relative;
		z-index: 3;
	}

	.over > :global(section) {
		border-radius: 40px 40px 0 0;
	}

	.panel {
		position: relative;
		z-index: 3;
		background: #fff;
	}

	.panel > :global(:last-child) {
		border-radius: 0 0 40px 40px;
	}

	.about-body {
		display: grid;
		gap: 40px;
		align-items: end;
	}

	.about-body :global(img) {
		max-width: 447px;
		aspect-ratio: 447 / 459;
		object-fit: cover;
		border-radius: var(--radius);
	}

	.about-body p {
		margin-top: 32px;
	}

	.centered {
		text-align: center;
	}

	.more {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-top: 27px;
		padding: 40px;
		border-radius: 20px;
		background: var(--mist);
	}

	:global(.stats) {
		display: grid;
		gap: 24px;
	}

	@media (min-width: 810px) {
		.about-body {
			grid-template-columns: minmax(245px, 447px) 1fr;
			gap: 64px;
		}

		:global(.stats) {
			grid-template-columns: repeat(4, 1fr);
		}

		:global(.stats) > :global(:nth-child(even)) {
			margin-top: 48px;
		}
	}

	@media (min-width: 1280px) {
		.reel :global(video) {
			aspect-ratio: 1.765;
		}
	}
</style>
