---
import { Image } from 'astro:assets';
import office from '@/assets/site/innosage-office.webp';
import PageHero from '@/components/PageHero.astro';
import PillLink from '@/components/PillLink.astro';
import PostCard from '@/components/PostCard.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import Section from '@/components/Section.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceSummary from '@/components/ServiceSummary.astro';
import StatCard from '@/components/StatCard.astro';
import Testimonials from '@/components/Testimonials.astro';
import Video from '@/components/Video.astro';
import { services } from '@/data/services';
import { stats } from '@/data/site';
import Base from '@/layouts/Base.astro';
import { getFeaturedProjects, getPosts } from '@/lib/content';
import { tones } from '@/lib/tones';

const lede =
	"People buy from brands they instantly recognize. We combine honest creativity with smart technology to give your business an undeniable look and a voice people actually trust—whether it's on a physical package or a digital screen.";
const featured = await getFeaturedProjects();
const posts = (await getPosts()).slice(0, 3);
---

<Base title="Innosage | Brand strategy and design, built to last." description={lede} image={office} headerTone="navy">
	<PageHero
		tone="navy"
		align="center"
		tight
		title="Becoming a trusted brand takes design, storytelling, strategy. We handle it all."
		lede={lede}
	/>
	<div>
		<div class:list={['sticky top-0 z-1 pt-10 pb-(--section-y)', tones.navy]}>
			<div class="shell">
				<div class="rounded-card border-4 border-paper shadow-[0_0_14px_rgb(244_243_239/0.3)]">
					<Video
						class="aspect-[1.25] rounded-card object-cover desk:aspect-[1.765]"
						src="/videos/Innosage-Brand-Promo.webm"
					/>
				</div>
			</div>
		</div>

		<div class="relative z-3 [&>section]:rounded-t-panel">
			<Section>
				<SectionHeading title="About Us" action={{ href: '/about/', label: 'ABOUT US' }} />
				<div class="grid items-end gap-10 tablet:grid-cols-[minmax(245px,447px)_1fr] tablet:gap-16">
					<Image
						class="aspect-447/459 max-w-111.75 rounded-card object-cover grayscale"
						src={office}
						alt="The Innosage office"
						widths={[447, 894]}
						sizes="(min-width: 810px) 447px, 100vw"
						loading="lazy"
						data-reveal
					/>
					<div>
						<h5>We are dedicated to elevating brands and transforming perspectives.</h5>
						<p class="mt-8">
							At Innosage, we go beyond traditional consulting. Our expertise spans across design, digital innovation,
							marketing, communication, and brand consultation. We craft customized strategies that drive extraordinary
							growth and generate high demand for our clients.
						</p>
					</div>
				</div>
			</Section>
		</div>
	</div>

	<div class="relative z-3 bg-white [&>:last-child]:rounded-b-panel">
		<Section class="wide:w-[calc(100%-192px)] wide:max-w-350 wide:px-0">
			<h2 class="mb-20 text-center">Featured Portfolio</h2>
			<ProjectGrid projects={featured} />
			<div class="mt-20 flex flex-col items-start gap-8 rounded-card bg-mist p-8 tablet:ml-auto tablet:w-1/2">
				<div>
					<p class="mb-2">Can't get enough?</p>
					<h4>Get ready to see more..</h4>
				</div>
				<PillLink href="/works/" label="ALL PROJECTS" />
			</div>
		</Section>

		<Section>
			<SectionHeading
				title="Ambition and dedication for the attention to detail."
				lede="Strategic Design, Flawless Development, Unmatched Results"
				action={{ href: '/services/', label: 'SERVICE DETAILS' }}
			/>
			<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-6">
				{services.map((service) => (
					<ServiceSummary {...service} />
				))}
			</div>
		</Section>

		<Testimonials />

		<Section class="grid gap-6 tablet:grid-cols-4">
			{stats.map((stat) => (
				<StatCard {...stat} />
			))}
		</Section>

		<Section>
			<SectionHeading
				level="h4"
				title="Insights to keep you moving forward"
				action={{ href: '/blogs/', label: 'ALL INSIGHTS' }}
			/>
			<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-6">
				{posts.map((post) => (
					<PostCard post={post} variant="compact" />
				))}
			</div>
		</Section>
	</div>
</Base>
