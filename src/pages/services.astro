---
import FeatureCard from '../components/FeatureCard.astro';
import Marquee from '../components/Marquee.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceDetail from '../components/ServiceDetail.astro';
import { reasons, serviceGallery, services } from '../data/services';
import Base from '../layouts/Base.astro';

const lede =
	'We partner with founders to build brand identities rooted in strategy, shaped by design, and amplified through storytelling. From your logo to your campaigns, everything speaks the same language—yours.';
---

<Base title="Services | Innosage" description={lede} headerTone="navy">
	<PageHero tone="navy" title="Brands don’t need noise. They need clarity." lede={lede} />
	<Section>
		<h5>
			Your brand isn’t built in a logo file. It’s built in how you look, sound, move, and make people
			feel. We shape every part of that—from first impression to final scroll.
		</h5>
	</Section>

	{
		services.map((service, index) => (
			<>
				<Section>
					<ServiceDetail {...service} />
				</Section>
				<div class="white gallery">
					<Marquee items={serviceGallery} variant="gallery" reverse={index === 1} />
				</div>
			</>
		))
	}

	<Section tone="ice" class="reasons">
		<SectionHeading title="Good Design is Bare Minimum. We Bring the Brains Too." />
		<div class="cards">
			{reasons.map((reason) => <FeatureCard {...reason} />)}
		</div>
	</Section>
</Base>

<style>
	.gallery {
		position: relative;
		padding-bottom: 80px;
	}

	:global(.reasons) {
		--rule: rgb(255 255 255 / 0.5);
	}
</style>
